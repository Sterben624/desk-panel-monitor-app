<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>860</width><height>600</height></rect>
  </property>
  <property name="windowTitle">
   <string>Панель моніторингу</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
QWidget {
    font-family: &quot;Ubuntu&quot;, &quot;Segoe UI&quot;, sans-serif;
    font-size: 10pt;
    color: #212121;
    background-color: #f0f2f5;
}
QGroupBox {
    font-weight: bold;
    border: 1px solid #c5cad3;
    border-radius: 6px;
    margin-top: 10px;
    padding: 8px 6px 6px 6px;
    background-color: #ffffff;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #1565c0;
    background-color: #ffffff;
}
QProgressBar {
    border: 1px solid #c5cad3;
    border-radius: 4px;
    background-color: #e8eaed;
    text-align: center;
    min-height: 16px;
}
QProgressBar::chunk {
    background-color: #1976d2;
    border-radius: 3px;
}
QPushButton {
    background-color: #1976d2;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 5px 14px;
    font-weight: bold;
}
QPushButton:hover { background-color: #1565c0; }
QPushButton:pressed { background-color: #0d47a1; }
QPushButton:checked { background-color: #388e3c; }
QPushButton:checked:hover { background-color: #2e7d32; }
QTabWidget::pane {
    border: 1px solid #c5cad3;
    background-color: #f0f2f5;
    top: -1px;
}
QTabBar::tab {
    background-color: #dde1e8;
    border: 1px solid #c5cad3;
    border-bottom: none;
    border-radius: 4px 4px 0 0;
    padding: 5px 20px;
    margin-right: 2px;
    color: #546e7a;
}
QTabBar::tab:selected {
    background-color: #f0f2f5;
    color: #1565c0;
    font-weight: bold;
}
QTabBar::tab:hover:!selected { background-color: #cdd1d8; }
QLineEdit, QComboBox, QDoubleSpinBox, QSpinBox {
    border: 1px solid #c5cad3;
    border-radius: 4px;
    padding: 3px 7px;
    background-color: #ffffff;
}
QFrame#connFrame {
    background-color: #ffffff;
    border: 1px solid #c5cad3;
    border-radius: 6px;
}
QCheckBox { spacing: 8px; }
QCheckBox::indicator {
    width: 16px; height: 16px;
    border: 1px solid #c5cad3;
    border-radius: 3px;
    background-color: #ffffff;
}
QCheckBox::indicator:checked {
    background-color: #1976d2;
    border-color: #1976d2;
}
QStatusBar { background-color: #ffffff; border-top: 1px solid #c5cad3; }
   </string>
  </property>

  <widget class="QWidget" name="centralwidget">
   <layout class="QVBoxLayout" name="mainLayout">
    <property name="spacing"><number>8</number></property>
    <property name="leftMargin"><number>10</number></property>
    <property name="topMargin"><number>10</number></property>
    <property name="rightMargin"><number>10</number></property>
